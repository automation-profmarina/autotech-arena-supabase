# ==============================================================================
# AUTOTECH ARENA - VARIÁVEIS DE AMBIENTE (SUPABASE)
# ==============================================================================
# 1. Crie um projeto gratuito em https://supabase.com
# 2. Acesse: Project Settings (ícone de engrenagem) -> API
# 3. Copie a "Project URL" e a chave pública "anon / public"
# 4. Preencha estas mesmas chaves no arquivo js/config.js (ou via interface web)
# NUNCA coloque a chave "service_role" (secreta) no frontend!

SUPABASE_URL=https://seu-projeto-id.supabase.co
SUPABASE_ANON_KEY=sua-chave-publica-anon-aqui
